<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Combat Camera - Configurable</name>
    <modid>CombatCamera</modid>
    <description>Free camera in camera-directed, fixed-target and untargeted combat. Aim unlocked attacks with the camera and configure the behavior in Mod Setting Menu.</description>
    <author>my-mods</author>
    <version>2.0.0</version>
    <created_on>2026-09-13</created_on>
  </info>
  <supports><game>The Blood of Dawnwalker</game><steam_build>25232147</steam_build><loader>Framecore 2b</loader></supports>
  <dependencies><dependency>Mod Setting Menu 1.0.6 or later</dependency></dependencies>
</mod>
